# Server Configuration
PORT=3001

# MongoDB Configuration
MONGODB_URI=mongodb://username:password@host:port/database
MONGODB_DATABASE=threespeak
MONGODB_COLLECTION_VIDEOS=embed-video
MONGODB_COLLECTION_USERS=embed-users
MONGODB_COLLECTION_KEYS=embed-api-keys
MONGODB_COLLECTION_JOBS=embed-jobs

# Upload Configuration
UPLOAD_DIR=./uploads

# tusd binary (Go-based TUS server — handles parallel chunk uploads via Concatenation extension)
# Run: bash scripts/install-tusd.sh  to download the binary
TUSD_PORT=1080
TUSD_BINARY_PATH=./bin/tusd

# Base URL for embed links
BASE_URL=https://play.3speak.tv/embed

# Demo API Key (for public demo page)
DEMO_API_KEY=sk_demo_generate-a-secure-key-here

# Admin Password (for admin panel access)
ADMIN_PASSWORD=change-me-in-production

# IPFS Configuration
IPFS_API_ADDR=/ip4/127.0.0.1/tcp/5001

# Encoder API Configuration
# Multi-encoder support: JSON array of encoder configs
# Format: [{"name":"encoder1","url":"https://encoder.example.com","apiKey":"key123","enabled":true}]
ENCODERS=[{"name":"snapie","url":"https://snapie.3speak.tv","apiKey":"your-encoder-api-key","enabled":true}]

# Webhook Configuration
WEBHOOK_API_KEY=generate-secure-key-with-openssl-rand-hex-32
WEBHOOK_URL=https://embed.3speak.tv/webhook

# Job dispatcher gate. Defaults to true. Set to false on secondary deployments
# that share a Mongo embed-jobs collection with a primary so only one instance
# dispatches encoder jobs — the dispatch path isn't atomic across replicas, so
# two pollers can double-dispatch the same job.
DISPATCHER_ENABLED=true

# Upload Token Configuration (optional — enables token-based auth for client-side uploads)
# When set, frontends can request short-lived upload tokens instead of exposing API keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UPLOAD_TOKEN_SECRET=
UPLOAD_TOKEN_DEFAULT_TTL=600           # Default token lifetime in seconds (default: 600 = 10 min)
UPLOAD_TOKEN_MAX_TTL=1800              # Maximum allowed TTL in seconds (default: 1800 = 30 min)
UPLOAD_TOKEN_MAX_FILE_SIZE=1073741824  # Max upload size per token in bytes (default: 1GB)

# Legacy single encoder support (fallback if ENCODERS is empty)
ENCODER_API_URL=https://snapie.3speak.tv
ENCODER_API_KEY=your-encoder-api-key

# Daily upload limits (rolling 24 hours). ON unless set to exactly "false"
# (kill switch). Warm-up accounts get 3 videos + 3 shorts a day
# (UPLOAD_LIMIT_WARMUP_VIDEOS_PER_DAY / _SHORTS_PER_DAY). Stream VODs never
# count; Pro and listed owners are exempt. See README "Upload Limits".
UPLOAD_DAILY_LIMITS_ENABLED=true
# Free Hive accounts have no upload cap (their limit is on publishing, enforced
# by the checker). Set to exactly "true" to cap their uploads again with the
# two limits below.
UPLOAD_LIMIT_FREE_UPLOADS_CAPPED=false
# Free Hive accounts while capped: regular videos per 24h (default 1) and
# shorts per 24h (default 3)
UPLOAD_LIMIT_VIDEOS_PER_DAY=1
UPLOAD_LIMIT_SHORTS_PER_DAY=3
# Comma list of owners who are never limited
UPLOAD_LIMIT_EXEMPT=
# Optional: warm-up lookup (default https://checker.3speak.tv/incubation/authors),
# Hive API nodes for the warm-up check (comma list, default api.hive.blog,
# api.deathwing.me, anyx.io) and the upgrade link in refusals ({owner} is
# replaced; default https://3speak.tv/wallet/{owner}#pro)
# UPLOAD_LIMIT_WARMUP_LOOKUP_URL=
# UPLOAD_LIMIT_HIVE_NODES=
# UPLOAD_UPGRADE_URL=
# Publish limit for other apps: an upload by a free Hive account through an API
# key whose app_name is not in the skip list is refused while the checker says
# it cannot publish one more of that kind now (1 video, 3 shorts per 24h). ON
# unless set to exactly "false"; not checked while free uploads are capped.
UPLOAD_PUBLISH_CHECK_ENABLED=true
# Optional: checker base URL (default https://checker.3speak.tv) and the API
# key app names that check the publish limit themselves (comma list, case
# insensitive; default 3speak,3speak-editor)
# UPLOAD_PUBLISH_CHECK_URL=
# UPLOAD_PUBLISH_CHECK_SKIP_APPS=
